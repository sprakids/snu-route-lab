# Developer/backend configuration. End users do not enter API keys.
# Existing Seoul bus credential is automatically loaded from Windows DPAPI.
SEOUL_BUS_SERVICE_KEY=
# Kakao JavaScript platform key: used by browser SDK with registered domain.
KAKAO_JAVASCRIPT_KEY=
# Kakao REST key: server-side only; never returned by API/bootstrap.
KAKAO_REST_API_KEY=
